APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://username:password@host:5432/postgres
APP_AUTH_SECRET=replace-with-strong-random-backend-only-secret
APP_AUTH_ISSUER=student-management-backend
APP_AUTH_AUDIENCE=student-management-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=390000
PASSWORD_PEPPER=replace-with-optional-backend-only-pepper
FRONTEND_ORIGIN=http://localhost:8921
SUPABASE_URL=http://localhost:54321
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
WHATSAPP_MODE=SIMULATOR
SIMULATOR_URL=http://host.docker.internal:3001/api/meta_outbound
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
TEMPLATE_FEE_RECEIPT=fee_payment_receipt_v1
TEMPLATE_ATTENDANCE_ABSENT=attendance_absent_v1
TEMPLATE_MARK_CORRECTION=single_student_correction_v1
TEMPLATE_EXAM_PUBLISHED=exam_results_published_v1
BACKEND_HOST_PORT=8920
