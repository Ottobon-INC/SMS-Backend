APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://username:password@host:5432/postgres
APP_AUTH_SECRET=replace-with-strong-random-backend-only-secret
APP_AUTH_ISSUER=student-management-backend
APP_AUTH_AUDIENCE=student-management-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=390000
PASSWORD_PEPPER=replace-with-optional-backend-only-pepper
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_STORAGE_BUCKET=student-management-local
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
WHATSAPP_MODE=SIMULATOR
SIMULATOR_URL=http://localhost:8000/api/v1/whatsapp-simulator/outbound
META_CLOUD_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
